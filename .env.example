# Variables de entorno del juego (opcionales). No pongas valores reales en el repositorio.
# URL del backend de la clasificación online del modo historia. Sin ella se usa game/leaderboard_url.txt;
# si tampoco existe, la clasificación es solo local. La Arena (LAN) no la usa.
CIVITAS_API=
# Semilla fija para pruebas reproducibles (historia y QA). Vacío = aleatoria.
ALCALDE_SEMILLA=
# Las variables del backend están en leaderboard/.env.example
