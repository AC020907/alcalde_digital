# Copy to .env only for your own tooling; the app reads real environment variables.
ENV=development
# SQLite is used when unset. Neon/Supabase: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Comma separated origins of the web build, e.g. https://user.itch.io,https://game.example.com
ALLOWED_ORIGINS=
# Set to 1 only behind a trusted proxy (Render) so X-Forwarded-For is honored.
TRUST_PROXY=0
# Enables DELETE /api/admin/scores/{run_id}. Leave empty to disable.
ADMIN_TOKEN=
